# 公开模板不含真实凭据；复制为 .env 后填写，进程环境变量优先。
# demo 仅读正式 JSONL；database 才连接 MySQL、Neo4j。
QA_BACKEND=demo
QA_DATA_DIR=data
QA_DATASET=wine-qa-system
QA_SNAPSHOT=
QA_MAX_RESULTS=10
QA_PRICE_ENABLED=false
QA_PRICE_MAX_AGE_DAYS=30

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wine_qa_reader
MYSQL_PASSWORD=
MYSQL_DATABASE=Wine_QA_System

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# 选择实际数据库，与库内归属 QA_DATASET 分开管理。
NEO4J_DATABASE=wine-qa-system
NEO4J_VECTOR_INDEX=qa_chunk_embedding

# 留空时不请求模型，使用基础规则和事实模板。
# 接口路径 /chat/completions、/embeddings 由程序追加。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
# 例如 Qwen/Qwen3-Embedding-8B 原生为 4096 维，需与实际输出一致。
# 当前适配器校验维度，不向接口发送 dimensions 参数。
EMBEDDING_ENCODING=plain-v1
MODEL_TIMEOUT_SECONDS=30
